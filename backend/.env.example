# ==============================================================================
# College Daily Morning Attendance Management System - backend environment
# (EXAMPLE FILE - safe to commit)
#
# Copy this file to `backend/.env` and fill in real values there.
# `.env` files are git-ignored and must NEVER be committed.
# ==============================================================================

# --- Server ---
# development | test | production
NODE_ENV=development

# HTTP port for the API. Development default: 4000.
# The Vite dev proxy (frontend/vite.config.ts) forwards /api here.
PORT=4000

# IANA time zone used to derive the attendance calendar date.
# Keep Asia/Kolkata: one morning session must map to one local (IST) date.
APP_TIMEZONE=Asia/Kolkata

# --- Authentication and sessions (REQUIRED) ---
#
# JWT_SECRET signs login session tokens (HS256) and the CSRF tokens.
# Generate one with either command and paste the output:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
#
# Rules: at least 32 characters, unique per environment, never reused,
# never committed, never sent to the browser.
JWT_SECRET=

# How long a login session stays valid (hours). Default: 12.
SESSION_TTL_HOURS=12

# Name of the HTTP-only session cookie. The CSRF cookie is this name plus
# "_csrf". Changing it also requires updating CSRF_COOKIE_NAME in
# frontend/src/lib/api.ts.
SESSION_COOKIE_NAME=ca_session

# --- OTP (student self-attendance; used from the attendance phase) (REQUIRED) ---
#
# OTP_PEPPER is mixed into the HMAC hash of attendance OTPs. Plaintext OTPs
# are never stored. Generate the same way as JWT_SECRET (separate value!).
OTP_PEPPER=

# OTP behavior, settled with the college: 6 digits, 10 minutes, 5 attempts.
# OTP_LENGTH must be 4-8; OTP_TTL_MINUTES 1-60; OTP_MAX_ATTEMPTS 1-20.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Database: Supabase-hosted PostgreSQL ---
#
# WHERE TO FIND IT:
#   Supabase Dashboard -> your project -> Project Settings -> Database
#   -> "Connection string" -> URI. Replace [YOUR-PASSWORD] with the database
#   password you chose when creating the Supabase project.
#
# WHICH URI TO USE:
#   * Session pooler (recommended for this backend): host looks like
#     aws-0-<region>.pooler.supabase.com, user postgres.<project-ref>,
#     port 5432. Works on IPv4-only networks and suits long-lived
#     node-postgres pools.
#   * Direct connection: host db.<project-ref>.supabase.co, port 5432.
#     Fine if your network supports IPv6.
#
# TLS (important):
#   Supabase serves its database certificate from a Supabase-managed CA that
#   public trust stores do not know; a plain connection therefore fails with
#   "self-signed certificate in certificate chain". The correct fix is to pin
#   Supabase's CA certificate — NEVER to disable verification:
#
#     1. Supabase Dashboard -> Project Settings -> Database -> SSL
#        Configuration -> download the certificate (e.g. prod-ca-2021.crt).
#     2. Save it as backend/certs/supabase-ca.crt (create the folder).
#     3. Keep the query parameters in the URI exactly like the example below:
#        sslmode=verify-full verifies the certificate chain AND hostname;
#        sslrootcert is the path to the downloaded CA, relative to backend/.
#
# SECURITY:
#   * Never use sslmode=no-verify / rejectUnauthorized=false, and never use
#     uselibpqcompat=true to weaken verification. Fix the certificate instead.
#   * This value is server-side only. Never put it in frontend variables.
#
# Leave empty to run the API without a database; /api/health will report
# database status as "not_configured" and database-backed endpoints (login,
# migrations) will refuse to run.
DATABASE_URL=

# Example shape (do NOT use these fake values):
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt

# --- Testing (optional) ---
#
# A separate disposable PostgreSQL database for integration tests. Migrations
# are applied and rows are created there, so it must NOT be the development
# database. When unset, database-backed tests are skipped automatically.
# TEST_DATABASE_URL=postgresql://...?sslmode=require
